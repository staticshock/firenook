rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /posts/{post} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.author == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author == request.auth.uid;
    }
    match /admin/{doc} {
      allow read, write: if request.auth.token.admin == true;
    }
    match /orders/{order} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
  }
  match /databases/{database}/documents/teams/{team} {
    allow list: if exists(/databases/$(database)/documents/members/$(team));
  }
  match /databases/{database}/documents/chores/{chore} {
    allow list: if resource.data.owner == request.auth.uid;
  }
}
